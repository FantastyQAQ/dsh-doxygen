{
  "name": "dsh-doxygen",
  "version": "1.0.0",
  "description": "Doxygen comment generator and maintainer for C/C++ (including Qt) sources, shipped as a DeepSeek Harness skill bundle.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "scripts",
    "assets",
    "references",
    "requirements.txt",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "skill",
    "doxygen",
    "documentation",
    "cpp",
    "qt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantastyQAQ/dsh-doxygen.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
